@model PaginatedList<Student>

@{
    ViewData["Title"] = "Index";
}

<div class="controls">
    <h1>Students</h1>

    <form asp-action="Index" method="get">
        <div>
            <label>Поиск по имени: <input type="search" name="SearchString" value="@ViewData["CurrentFilter"]" /></label>
            <input type="submit" value="Найти" class="btn btn-primary" />
            <a asp-action="Index" class="btn btn-secondary">Сброс</a>
        </div>
    </form>

    <a asp-action="Create" class="btn btn-primary">Create New</a>
</div>

<div class="paginator">
    <table class="table">
        <thead>
            <tr>
                <th>
                    <a asp-action="Index" asp-route-sortOrder="@ViewData["NameSortParam"]" asp-route-currentFilter="@ViewData["CurrentFilter"]">
                        @Html.DisplayNameFor(model => model.First().FullName)
                    </a>
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.First().group)
                </th>
                <th>
                    <a asp-action="Index" asp-route-sortOrder="@ViewData["DateSortParam"]" asp-route-currentFilter="@ViewData["CurrentFilter"]">
                        @Html.DisplayNameFor(model => model.First().birth_date)
                    </a>
                </th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(model => item.FullName)
                    </td>
                    <td>
                        @Html.DisplayFor(model => item.group)
                    </td>
                    <td>
                        @Html.DisplayFor(model => item.birth_date)
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-stud_id="@item.stud_id">Edit</a> |
                        <a asp-action="Details" asp-route-stud_id="@item.stud_id">Details</a> |
                        <a asp-action="Delete" asp-route-stud_id="@item.stud_id">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@{
    string prevDisabled = Model.HasPreviousPage ? "" : "disabled";
    string nextDisabled = Model.HasNextPage ? "" : "disabled";
}

<div class="pagination-controls">
    <a asp-action="Index"
       asp-route-sortOrder="@ViewData["CurrentSort"]"
       asp-route-pageNumber="@(Model.PageIndex - 1)"
       asp-route-currentFilter="@ViewData["CurrentFilter"]"
       class="btn btn-default @prevDisabled">
        Prev
    </a>

    <a asp-action="Index"
       asp-route-sortOrder="@ViewData["CurrentSort"]"
       asp-route-pageNumber="@(Model.PageIndex + 1)"
       asp-route-currentFilter="@ViewData["CurrentFilter"]"
       class="btn btn-default @nextDisabled">
        Next
    </a>
</div>