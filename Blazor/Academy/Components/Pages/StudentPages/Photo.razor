<div class="photo">
    @if (Image != null && Image.Length > 0)
    {
        <img src="data:image/png;base64, @Convert.ToBase64String(Image)"/>
    }
    else
    {
        <div class="photo">
            <span>Нет фото</span>
        </div>
    }
</div>

@code
{
	// [Parameter]
	// public IBrowserFile URL { get; set; }
	// [Parameter]
	// public byte[] Image { get; set; } = default!;
	[Parameter]
	public byte[]? Image { get; set; }
}