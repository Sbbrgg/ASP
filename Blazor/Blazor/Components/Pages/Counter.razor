@page "/counter"
@rendermode InteractiveServer

<PageTitle>Clicker</PageTitle>

<h1>Clicker</h1>

<p role="status">Current count: @currentCount</p>
<input type="number" max="5" @bind="increment"/>

<button class="btn btn-primary" @onclick="IncrementCount">Increment</button>
<button class="btn btn-primary" @onclick="Reset">Reset</button>
<button class="btn btn-primary" @onclick="UpStep">Up Step to @next_increment</button>


@code {
    private int currentCount = 0;
    private static int increment = 1;
    private int next_increment = increment * 2;
    private void IncrementCount()
    {
        currentCount+=increment;
    }
    void Reset()
    {
        currentCount = 0;
    }
    void UpStep()
    {
        currentCount -= (100 + (increment/2) * 100 + (increment/2) * 100);
        increment = increment * 2;
        next_increment = increment * 2;
    }
}